# SkuPhase Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=SkuPhase
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (PostgreSQL)
# For local development: postgresql://postgres:password@localhost:5432/skuphase_dev
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/skuphase_dev"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase Configuration
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_KEY="[SERVICE_KEY]"

# Authentication
JWT_SECRET_KEY="your-secret-key-min-32-chars-long-change-in-production"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID="[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[YOUR_GOOGLE_CLIENT_SECRET]"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# LLM Providers
GROK_API_KEY="[YOUR_GROK_API_KEY]"
OPENROUTER_API_KEY="[YOUR_OPENROUTER_API_KEY]"
OPENAI_EMBEDDING_API_KEY="[YOUR_OPENAI_API_KEY]"

# File Processing
MAX_FILE_SIZE_MB=25
PDF_IMAGE_EXTRACTION_ENABLED=true
OCR_ENABLED=true

# Background retries (no broker)
BACKGROUND_RETRY_ATTEMPTS=3
BACKGROUND_RETRY_BASE_DELAY_SECONDS=2.0

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_CREDENTIALS=true

# API
ENABLE_SWAGGER=true
API_PREFIX=/api/v1
