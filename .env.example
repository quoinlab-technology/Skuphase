# SkuPhase Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=SkuPhase
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (PostgreSQL) — must use the asyncpg driver
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/skuphase_dev"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication
JWT_SECRET_KEY="your-secret-key-min-32-chars-long-change-in-production"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email delivery (MVP: Gmail SMTP with an App Password)
# 1. Enable 2FA on the sender Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
MAIL_PROVIDER=smtp                 # smtp | resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=                         # optional; falls back to SMTP_USER
# Public origin used in verification, reset, and invitation links.
APP_BASE_URL=http://localhost:8000

# Resend (dormant — switch by setting MAIL_PROVIDER=resend)
RESEND_API_KEY=

# LLM Providers (Groq primary, OpenRouter fallback)
GROQ_API_KEY="[YOUR_GROQ_API_KEY]"
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY="[YOUR_OPENROUTER_API_KEY]"

# Background retries (Postgres-backed jobs, no broker)
BACKGROUND_RETRY_ATTEMPTS=3
BACKGROUND_RETRY_BASE_DELAY_SECONDS=2.0

# CORS — JSON array or comma-separated string both work
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_CREDENTIALS=true

# API docs
ENABLE_SWAGGER=true
