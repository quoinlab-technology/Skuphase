# FastAPI Cloud / production environment template.
# Set these in the hosting provider, never commit real credentials.
APP_ENV=production
DEBUG=false
ENABLE_SWAGGER=false
APP_BASE_URL=https://your-public-domain.example
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
CORS_ORIGINS=["https://your-public-domain.example"]
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@your-public-domain.example
GROQ_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
